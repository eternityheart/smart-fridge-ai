# ====================================
# 智能冰箱视觉服务 - 生产环境配置
# ====================================

# 服务配置
FLASK_ENV=production
FLASK_DEBUG=False
SERVICE_HOST=0.0.0.0
SERVICE_PORT=5000

# 模型配置
MODEL_PATH=models/yolov8m_fridge.pt
CONFIDENCE_THRESHOLD=0.6
IOU_THRESHOLD=0.45

# GPU 配置
USE_GPU=True
CUDA_VISIBLE_DEVICES=0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/vision_prod.log

# 后端服务地址 (Docker 网络)
BACKEND_URL=http://fridge-api:8080

# DeepSeek API
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
