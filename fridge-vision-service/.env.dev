# ====================================
# 智能冰箱视觉服务 - 开发环境配置
# ====================================

# Python 解释器路径
PYTHON_INTERPRETER=D:\miniconda3\envs\pytorch-2.6.0-gpu\python.exe

# 服务配置
FLASK_ENV=development
FLASK_DEBUG=True
SERVICE_HOST=0.0.0.0
SERVICE_PORT=5000

# 模型配置
MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# GPU 配置
USE_GPU=True
CUDA_VISIBLE_DEVICES=0

# 日志配置
LOG_LEVEL=DEBUG
LOG_FILE=logs/vision_dev.log

# 后端服务地址 (用于回调)
BACKEND_URL=http://localhost:8080

# DeepSeek API (用于食材名称清洗)
DEEPSEEK_API_KEY=sk-a14e811472d4472baa0e014f35042091
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
